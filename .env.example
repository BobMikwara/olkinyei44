# Frontend (public browser credentials — safe to expose; RLS protects data).
# MUST be present in Vercel → Settings → Environment Variables → Production
# BEFORE building. Add or change values, then trigger a fresh deployment:
# Vite inlines these values into the bundle at build time.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vercel serverless functions (NEVER exposed to the browser).
# Set under the same Vercel environment, no VITE_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by /api/invite-user to build emailed redirect URLs.
PRODUCTION_SITE_URL=https://premiumolkinyei.vercel.app

# Resend / email delivery secrets booked for Supabase Edge Functions.
# RESEND_API_KEY=re_...
# BOOKING_TEAM_EMAIL=journeys@olkinyei.com
# BOOKING_ROOT_EMAIL=root@example.com
# BOOKING_FROM_EMAIL="Olkinyei Expeditions <journeys@your-verified-domain.com>"

# ---------------------------------------------------------------------------
# External review providers (server-side only — never VITE_ prefixed).
#
# Both integrations are OPTIONAL. The website and CMS work normally when these
# are unset; the Testimonials module simply reports the provider as
# "Not configured" and no reviews are imported.
#
# Set these in Vercel → Settings → Environment Variables (Production) only when
# you hold authorised API access. Never commit real keys.
# ---------------------------------------------------------------------------

# Tripadvisor Content API — requires an approved partner key.
# TRIPADVISOR_API_KEY=
# TRIPADVISOR_LOCATION_ID=
# TRIPADVISOR_API_BASE_URL=https://api.content.tripadvisor.com/api/v1

# SafariBookings partner API — requires official operator access.
# Scraping is not supported; leave unset until an authorised API is available.
# SAFARIBOOKINGS_API_KEY=
# SAFARIBOOKINGS_OPERATOR_ID=
# SAFARIBOOKINGS_API_BASE_URL=
